# Build outputs are regenerated inside the image; never send local ones.
node_modules
**/node_modules
**/lib
**/dist
.pnpm-store
coverage
# Local-only secrets, logs, and editor/OS noise.
.env
*.log
npm-debug.log*
.DS_Store
# NOTE: .git is intentionally NOT ignored — scripts/client-build-environment.ts
# stamps the build from `git rev-parse HEAD`, so the build fails without it.
# Staged wallet dep for the dai branch's bigtangle-ts link (Dockerfile places
# it at /app/bigtangle-ts): keep its built dist; its deps install in the image.
!bigtangle-ts
!bigtangle-ts/dist
!bigtangle-ts/dist/**

# The `min` image unpacks the AppImage the Desktop packaging pipeline writes.
# Send only that artifact, never the multi-gigabyte build tree beside it.
apps/desktop/.desktop-build/**
!apps/desktop/.desktop-build/targets
!apps/desktop/.desktop-build/targets/linux-x64
!apps/desktop/.desktop-build/targets/linux-x64/unsigned-artifacts
!apps/desktop/.desktop-build/targets/linux-x64/unsigned-artifacts/*.AppImage
